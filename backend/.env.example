# ============================================================
# Copia este archivo como .env y ajusta los valores
# ============================================================

# --- Opción A: Autenticación de Windows (la misma que usas en SSMS)
DB_TRUSTED_CONNECTION=true
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=medieval_kingdoms
# Si "npm run dev" dice que no encuentra el driver, prueba con:
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# --- Opción B: usuario y contraseña de SQL Server
# (pon DB_TRUSTED_CONNECTION=false y completa estos)
DB_USER=
DB_PASSWORD=
# DB_PORT=1433
